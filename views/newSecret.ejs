<%- include('partials/headerSecret', { session: session }) %>

<h2>New Secret Note</h2>
<form action="/secret/new" method="POST">
  <input type="text" name="title" placeholder="Note title" required>
  <textarea name="body" placeholder="Write your secret note..." rows="5" required></textarea>
  <button type="submit">Save Secret Note</button>
</form>

