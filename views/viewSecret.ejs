<%- include('partials/headerSecret', { session: session }) %>

<% if (note) { %>
  <h2>Secret Note</h2>
  <p><%= note.body %></p>
  <small>Posted on <%= note.datePosted.toDateString() %></small>
<% } else { %>
  <p>No note found for that key. Please check and try again.</p>
<% } %>

<%- include('partials/footer') %>
